{
  "expo": {
    "name": "ContaDin",
    "slug": "ContaDIN",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logos/contadin/Logo Contadin Default.svg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logos/contadin/Logo Contadin Default.svg",
      "resizeMode": "contain",
      "backgroundColor": "#03408E"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#03408E"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
