# URL base da API (use em desenvolvimento; deixe vazio para fallback automático)
# Ex.: http://192.168.15.13:8080 ou http://localhost:8080
EXPO_PUBLIC_API_BASE_URL=

# Serviço Python (ETL de planilha, OCR e transcrição de áudio)
# Ex.: http://192.168.X.X:8000  |  No browser pode usar http://localhost:8000
EXPO_PUBLIC_PYTHON_BASE_URL=

# Caminho do endpoint ETL
# Ex.: /data/process
EXPO_PUBLIC_ETL_IMPORT_PATH=/data/process

# Enviar Authorization Bearer para o ETL (normalmente desnecessario)
# false ajuda a evitar preflight CORS no navegador
EXPO_PUBLIC_ETL_SEND_AUTH=false

# Insira um usuário e senha para realizar o login mockado
EXPO_PUBLIC_SYSADMIN_EMAIL=
EXPO_PUBLIC_SYSADMIN_PASSWORD=